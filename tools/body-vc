#!/usr/bin/env python3
"""Export a Rust root and write its typed Lean safety verification condition."""

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile
import time

REPO = Path(__file__).resolve().parent.parent


def run(args, *, env=None, capture=False):
    return subprocess.run(
        args, cwd=REPO, env=env, check=True, text=True,
        stdout=subprocess.PIPE if capture else None,
    )


def rust_root(source, explicit):
    if explicit:
        return explicit
    code = re.sub(r"/\*.*?\*/|//[^\n]*", "", source.read_text(), flags=re.S)
    top = re.findall(
        r"^(pub(?:\([^\n)]*\))?\s+)?(?:(?:unsafe|async|const|extern(?:\s+\"[^\"]*\")?)\s+)*"
        r"fn\s+([a-zA-Z_]\w*)\s*[<(]", code, re.M,
    )
    names = [name for _, name in top]
    if "main" in names:
        return "main"
    if source.stem in names:
        return source.stem
    public = [name for visibility, name in top if visibility]
    if len(public) == 1:
        return public[0]
    if len(names) == 1:
        return names[0]
    raise ValueError("could not infer a unique Rust function; pass --root with its Rust def-path")


def lean_string(value):
    return json.dumps(str(value), ensure_ascii=False)


def exporter_environment(env):
    sysroot = Path(env.get("MIRI_SYSROOT", REPO / "scratch" / "miri-sysroot"))
    if not (REPO / sysroot).is_dir():
        raise ValueError("pinned Miri sysroot is missing; run tools/setup-miri-reference.sh")
    target = Path(env.get("CARGO_TARGET_DIR", REPO / "exporter" / "target"))
    if not (REPO / target / "release" / "lean-miri-mir-exporter").is_file():
        run(["bash", "tools/build-exporter.sh"], env=env)


def vc_source(mir, metadata):
    names = []
    for body in metadata["bodies"]:
        identity = body["identity"]
        names.append(f"-- Body {identity}" + (" (selected root)" if identity == metadata["rootIdentity"] else ""))
        for index, row in enumerate(body["equations"]):
            block, slot = row["pc"]
            op = row["operation"]
            successors = ", ".join(f"bb{bb}.{stmt}" for bb, stmt in row["targets"])
            detail = f" -> {successors}" if successors else ""
            names.extend([
                f"-- bb{block}.{slot} {op}{detail}",
                f"def body_{identity}_bb{block}_{slot} (config : Config) (limits : ExecutionMachine.Limits)",
                "    (allowed : State → C → Prop) (depth : Nat) : Prop :=",
                f"  safetyEquation config limits allowed depth (.ofCanonicalIndex {identity}) {index}",
            ])
        names.append("")
    nodes = "\n".join(names)
    return f"""-- Generated by tools/body-vc safety. Root: {lean_string(metadata['root'])}
import Miri.Frontend.ImportMIR
import Miri.Verification.BodyVCGen

namespace GeneratedBodySafety
open Miri.Frontend Miri.Interpreter Miri.Verification Std.WP
set_option maxHeartbeats 10000000
set_option maxRecDepth 65536
set_option experimental.vcgen true

open Lean Elab Command in
elab "import_sibling_mir " path:str " as " name:ident : command => do
  let source := System.FilePath.mk (← read).fileName
  let file := source.parent.getD "." / path.getString
  elabCommand (← `(import_mir $(Syntax.mkStrLit file.toString):str as $name:ident))

import_sibling_mir {lean_string(mir.name)} as input

def loaded : Except String BodyVCGen.LoadedProgram :=
  BodyVCGen.loadProgram input {metadata["rootIndex"]}

section
variable {{K U C O X Host : Type}} [DecidableEq K]
local notation "State" => MachineHooks.State K U
local notation "Config" => ExecutionMachine.Config K U C O X Host

/-- The exact pointwise safety VC at the supplied prepared state. -/
def requiredAt (config : Config) (limits : ExecutionMachine.Limits)
    (allowed : State → C → Prop) (before : State) : Prop :=
  match loaded with
  | .error _ => False
  | .ok program =>
    (BodyVCGen.generateProgram config limits program allowed (fun _ _ => True)
      BodyVCGen.noUB).pre before

/-- The same VC with every typed choice admitted. -/
abbrev requiredForEveryChoiceAt (config : Config) (limits : ExecutionMachine.Limits)
    (before : State) : Prop :=
  requiredAt config limits (fun _ _ => True) before

/-- The safety VC before production root-call preparation. -/
def requiredFromRoot (config : Config) (limits : ExecutionMachine.Limits)
    (launch : C) (arguments : Array (RvalueImmTy Miri.Memory.Provenance))
    (destination : Option (MPlaceTy Miri.Memory.Provenance)) (span : Miri.MIR.SpanRef)
    (allowed : State → C → Prop) (before : State) : Prop :=
  match loaded with
  | .error _ => False
  | .ok program => BodyVCGen.preparedProgramPre config limits program launch arguments destination
      span allowed (fun _ _ => True) BodyVCGen.noUB before

/-- The saved VC holds exactly when the initialized state is at the imported
entry and every permitted finite error in the call scope is non-UB. -/
theorem safetySpec (config : Config) (limits : ExecutionMachine.Limits)
    (allowed : State → C → Prop) (entry : State) (program : BodyVCGen.LoadedProgram)
    (selected : loaded = .ok program) :
    requiredAt config limits allowed entry ↔
      WholeBodyWP.entryMatchesLoaded program.root entry ∧
      ∀ failed error, WholeBodyWP.Finishes (ExecutionMachine.step config limits)
        (fun state => state.stack.frames.size) allowed entry.stack.frames.size
        entry failed (.error error) → RunLoop.reportsUB error = false := by
  simp only [requiredAt, selected, BodyVCGen.generatedProgramPre_eq, WholeBodyWP.catalogBodyPre_iff]
  constructor
  · rintro ⟨entered, checked⟩
    exact ⟨entered, fun failed error run => checked failed (.error error) run⟩
  · rintro ⟨entered, safe⟩
    refine ⟨entered, ?_⟩
    intro after result run
    cases result with
    | ok _ => trivial
    | error error => exact safe after error run

/-- Supply either the safety postcondition or an explicit typed pair of posts
and obtain the equation table used by the actual whole-program generator. -/
def verification (config : Config) (limits : ExecutionMachine.Limits)
    (allowed : State → C → Prop) (post : WholeBodyWP.Exit → State → Prop)
    (failure : StepError → State → Prop) : Except String (BodyVCGen.ProgramConditions State) :=
  loaded.map fun program => BodyVCGen.generateProgram config limits program allowed post failure

/-- Individual compiler-bound safety obligations share the whole-body
continuation at every successor, including loop and call successors. -/
def safetyEquation (config : Config) (limits : ExecutionMachine.Limits)
    (allowed : State → C → Prop) (depth : Nat) (identity : BodyIdentity) (index : Nat) : Prop :=
  match loaded with
  | .error _ => False
  | .ok program =>
    let plan := BodyVCGen.generateProgram config limits program allowed (fun _ _ => True)
      BodyVCGen.noUB
    let again := WholeBodyWP.catalogControlPre config limits plan.graph allowed depth
      (fun _ _ => True) BodyVCGen.noUB
    ((plan.equations (fun _ => again) again identity).bind (·[index]?)).getD False

{nodes}
end

#print axioms safetySpec
end GeneratedBodySafety
"""


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("goal", choices=["safety"])
    parser.add_argument("input", type=Path)
    parser.add_argument("--root", help="Rust def-path to select when the input has multiple functions")
    parser.add_argument("--panic", choices=["abort", "unwind"], default="abort",
                        help="panic strategy for fresh Rust export (default: abort)")
    parser.add_argument("--output", type=Path, default=Path("scratch/BodySafety.lean"))
    parser.add_argument("--no-build", action="store_true", help="reuse existing Lean build artifacts")
    parser.add_argument("--no-check", action="store_true", help="skip the separate generated-file Lean check")
    args = parser.parse_args()
    source, output = args.input.resolve(), args.output.resolve()
    if output.suffix != ".lean" or source.suffix not in {".rs", ".json"}:
        parser.error("the input must be .rs or .json and the output must be .lean")
    if not source.is_file():
        parser.error(f"input does not exist: {source}")

    env = os.environ.copy()
    local_elan = REPO / ".elan"
    if (local_elan / "bin" / "lake").exists():
        env.setdefault("ELAN_HOME", str(local_elan))
        env["PATH"] = str(local_elan / "bin") + os.pathsep + env["PATH"]
    if not args.no_build:
        run(["flock", "--no-fork", "/tmp/lean-miri-lake-build.lock", "lake", "build",
             "Miri.Frontend.ImportMIR", "Miri.Verification.BodyVCGen"], env=env)
    env.setdefault("LEAN_PATH", str(REPO / ".lake" / "build" / "lib" / "lean"))

    output.parent.mkdir(parents=True, exist_ok=True)
    mir = output.with_suffix(".mir.json")
    with tempfile.TemporaryDirectory(dir=output.parent) as directory:
        temporary_mir = Path(directory) / "input.json"
        root = args.root
        if source.suffix == ".rs":
            root = rust_root(source, root)
            exporter_environment(env)
            rust_args = [str(source), "--crate-name", re.sub(r"\W", "_", source.stem),
                         f"-Cpanic={args.panic}"]
            if root != "main":
                rust_args.append("--crate-type=lib")
            start = time.perf_counter()
            run(["bash", "tools/export-mir.sh", "--output", str(temporary_mir), "--root", root,
                 "--", *rust_args], env=env)
            print(f"Rust MIR export: {time.perf_counter() - start:.3f} s", flush=True)
        else:
            shutil.copyfile(source, temporary_mir)
        start = time.perf_counter()
        result = run(["lean", "-j1", "--run", "tools/GenerateBodyVC.lean",
                      str(temporary_mir), *([root] if root else [])], env=env, capture=True)
        metadata = json.loads(result.stdout)
        temporary_mir.replace(mir)
        output.write_text(vc_source(mir, metadata))
        print(f"VC generation and artifact writing: {time.perf_counter() - start:.3f} s", flush=True)

    if not args.no_check:
        start = time.perf_counter()
        run(["lean", "-j1", str(output)], env=env)
        print(f"Generated VC Lean check: {time.perf_counter() - start:.3f} s", flush=True)
    print(f"Saved {output} and {mir}")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, subprocess.CalledProcessError) as error:
        raise SystemExit(str(error)) from error
