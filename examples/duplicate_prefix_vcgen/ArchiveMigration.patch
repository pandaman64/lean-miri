+private theorem events_keep_slot (items : List TraversalEvent) (root : Nat)
+    (kind : AccessKind) (tree : NormalTreeState) (query : Nat)
+    (unvisited : ∀ item ∈ items, item.node ≠ query) :
+    (sourceNormalEvents tree root kind items).tree.locationStates[query]? = tree.locationStates[query]? := by
+  induction items generalizing tree with
+  | nil => rfl
+  | cons event rest ih =>
+    have before : event.node ≠ query := unvisited event (by simp)
+    have after : ∀ item ∈ rest, item.node ≠ query := fun item mem => unvisited item (.tail _ mem)
+    cases present : tree.stateAt event.node with
